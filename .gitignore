# Local and sensitive files — never commit these
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
tokens*

# Real case material must never be committed.
# Anchor these patterns to the repo root. A bare `cases/` also matches evals/cases/,
# which silently deletes the golden test set from every CI checkout - CI then reports
# green while only the negative cases run. Use /cases/ instead.
/cases/
/attachments/
/evals/private/
*.pdf
*.xlsx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Temp
*.tmp
*.log
node_modules/
